    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Music Generator – AI music generation pipeline</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Combines user selections into a Lyria prompt and spawns MusicObject instances.</span>"}'
