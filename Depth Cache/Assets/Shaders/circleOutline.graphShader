      DependencyIndex: 8
      LevelID: 0
      NodeType: 3
      Ports:
        Description:
          String: ""
        DescriptionText:
          ClassType1: TEXT
          String: |-
            Converts Cartesian UV Coordinates to Polar coordinates (r,θ).
            
            TIP: the most common use case is a standard quad with bottom left UV coordinates of (0,0) and upper right coordinates of (1,1); in this use case, the UV coordinates will be used to generate circular coordinates around the center (0.5, 0.5) of the quad. You can easily test this subgraph on a Plane or Image object.
            
            Parameters:
            - Direction: determines whether the theta (θ) coordinate will be measured from 0-1 in a clockwise or counter clockwise direction.
            - UV Coords: coordinates used to generate Polar coordinates. These are in the range [0,1].
            - Scale: applies scaling to the coordinates.
            - Rotation Offset (Degrees): adds angular offset in degrees to the starting angle (θ).
            - Center: the origin for the polar coordinates. The radius (r) and angle (θ) are measured relative to this center position. The default for UVs is (0.5, 0.5).
            
            Output:
            - Polar Coords:
                  - x = the radius from the center of the coordinates (r)
                  - y = the angle from the starting position (θ) 
        FirstTime:
          Variable: false
        Locked:
          Variable: false
        SubGraphUniqueID139:
          Variable: [0.0, 0.0, 0.0, 0.0]
        SubGraphUniqueID140:
          ItemIndex: 1
          ItemList: "Clockwise : Counter Clockwise"
        SubGraphUniqueID141:
          Variable: [0.0, 0.0, 0.0, 0.0]
        SubGraphUniqueID142:
          Variable: [0.0, 0.0, 0.0, 0.0]
        SubGraphUniqueID143:
          Connection0:
            NodeLevelID: 1
            PortID: UVCoord
          Variable: [0.0, 0.0, 0.0, 0.0]
        SubGraphUniqueID145:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
        Title1:
          String: Polar Coordinates
