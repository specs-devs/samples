    Node5:
      DependencyIndex: 5
      LevelID: 2
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            input_float objectWidth;  
            input_float objectHeight;
            input_float outlineThickness; 
            input_vec4 boxColor;
            input_vec4 outlineColor;
            input_vec3 objPos;
            output_vec4 ResultColor;
            
            // SDF for a rounded rectangle:
            //   p: point in world space (centered at 0)
            //   b: half-dimensions of the rectangle (in world units)
            //   r: corner radius (in world units)
            float sdRoundedRect(vec2 p, vec2 b, float r) {
                // Compute distance to a rounded rectangle.
                vec2 d = abs(p) - (b - vec2(r));
                return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0) - r;
            }
            
            void main()
            {
                // Convert normalized coordinates ([-0.5, 0.5]) to world space.
                // This makes pos range from -objectWidth/2 to +objectWidth/2 (and similarly for height).
                vec2 pos = vec2(objPos.x * objectWidth, objPos.y * objectHeight);
                
                // Compute half extents of the rectangle.
                vec2 halfSize = vec2(objectWidth, objectHeight) * 0.5;
                
                // Define the corner radius as a fraction of the smaller dimension.
                float cornerRadius = min(objectWidth, objectHeight) * 0.1; // adjust as desired
                
                // Compute the signed distance from pos to the rounded rectangle.
                // Negative values indicate points inside the rounded shape,
                // zero is exactly at the edge, positive is outside.
                float sdf = sdRoundedRect(pos, halfSize, cornerRadius);
                
                // Define an outline thickness (in world units) that scales with the object size.
                float outlineThickness = objectWidth * outlineThickness; // adjust as desired
            
                // Clip fragments outside the rounded rectangle.
                if (sdf > 0.0) {
                    discard;
                }
                // Draw the outline: fragments near the edge (sdf between 0 and -outlineThickness) become white.
                else if (sdf > -outlineThickness) {
                    ResultColor = outlineColor;
                }
                // Draw the interior: fragments further inside become black.
                else {
                    ResultColor = boxColor;
                }
            }

        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
