    startMinimized: true
    extraPanelDrop: true
  ScriptTypesDefault:
    {}
  ScriptInputs:
    "":
      examples: !<reference.SceneObject[]>
        - !<reference> b5277d5d-ad49-4cc3-b947-62ae71c01ed0
        - !<reference> b4d31687-1acb-4d20-8ed5-c4d0fabbb0b9
        - !<reference> d27e15fc-3a5e-48c5-8115-bc3acbd83a10
        - !<reference> 5eb9cbb5-c5b6-4dfc-85c6-17a7c0ede90a
        - !<reference> de4f74bf-46d2-40bb-801d-80201b0e079c
        - !<reference> 609ed68b-bc28-4417-be6b-cbf9a752ce58
      exampleInfo: !<string[]>
        - "Sync Transform: pinch the ghost and move it, and everyone in the session sees it move. Sync Material: the cube cycles through materials in sync for everyone."
        - "Script-only examples of SyncEntity, SessionController and the Snapchat user API, in TypeScript and JavaScript: nothing appears, they only report session events in the logs."
        - "Storage properties share values with everyone: the text types itself, cubes change color and stripes, and shapes circle around. Top row TypeScript, bottom row JavaScript."
        - "Each step spawns a shared ghost for everyone in the session (automatically, from TypeScript, from JavaScript). Pinch it and move it around."
        - "A debug panel shows the entity's network id, its owner and a synced property; pinch Claim / Unclaim to take or release ownership. The second step spawns the same panel from a prefab."
        - "The text shows a synced storage property: the current time, updated by its owner for everyone in the session."
      steps: !<reference.SceneObject[]>
        - !<reference> e7c142b1-abbc-46d9-a620-77dccc4971f1
        - !<reference> 08747682-536a-4290-adeb-88a1abb435ae
