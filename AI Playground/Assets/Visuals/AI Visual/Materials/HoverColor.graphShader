    Node30:
      DependencyIndex: 48
      LevelID: 6
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            output_float Outcolor;
            input_float radius;
            input_vec2 center;
            input_float feather;
            
            void main()
            {
                float dist = distance(center,vec2 (0.5,0.5));
                float aspect = 1.0;
                vec2 center = center*vec2(aspect,1.0);
                float radiusStart = radius;
                float radiusEnd = radius+dist;
                float radius = mix(radiusStart,radiusEnd,radius);
                vec2 TexCoords = system.getSurfaceUVCoord0()*vec2(aspect,1);
                float distanceFromCenter = distance(TexCoords, center);
                float inCircle = smoothstep(radius, radius - feather, distanceFromCenter);
                Outcolor = inCircle;
            }
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
