  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">GrabbableObject – Physics grab and throw with hand tracking</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Requires a MatchTransform and Physics.BodyComponent on the same object.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Object Settings</span>"}'
    - '// @input string objectType = "Ball" {"hint":"Type of object - determines grab behavior and rotation", "widget":"combobox", "values":[{"label":"Ball", "value":"Ball"}, {"label":"Racket", "value":"Racket"}, {"label":"Darts", "value":"Darts"}]}'
    - '// @input AssignableType_1 matchTransform {"hint":"Reference to the MatchTransform component on this object"}'
    - "// @input float destroyDelay = 4.5 {\"hint\":\"Time in seconds before destroying the object after it's dropped\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Dart Settings</span>"}'
    - '// @input SceneObject scoreBoard {"hint":"For Darts: The dartboard/scoreboard to look at when grabbed", "showIf":"objectType", "showIfValue":"Darts"}'
    - '// @input float dartThrowForce = 800 {"hint":"For Darts: Force applied when releasing (throw strength)", "showIf":"objectType", "showIfValue":"Darts"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Throw Settings</span>"}'
    - '// @input float ballThrowForce = 100 {"hint":"For Balls: extra speed (cm/s) added along the throw direction on release"}'
    - '// @input float handVelocityMultiplier = 1.6 {"hint":"Balls: throw speed = peak hand speed x this. Darts: hand speed x this is added to the dart force."}'
    - '// @input float minThrowSpeed = 300 {"hint":"For Balls: minimum release speed (cm/s), so even a gentle flick flies"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Racket Settings</span>"}'
    - '// @input bool racketFacesBallLauncher = true {"hint":"For Racket: while held, keep the racket upright and turned (around Y only) toward the ball launcher", "showIf":"objectType", "showIfValue":"Racket"}'
    - '// @input string racketHint = "Look left and hit the ball coming at you" {"hint":"For Racket: small hint shown above the racket (empty = none)", "showIf":"objectType", "showIfValue":"Racket"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Grab Zone</span>"}'
    - '// @input float grabZoneScale = 1.8 {"hint":"Size of the invisible grab zone relative to the physics collider (1 = same size). It is intangible: only the hands use it, throwing and collisions keep the real collider."}'
    - '// @input float grabZoneMinMargin = 3 {"hint":"Minimum extra margin (cm) the grab zone adds around the physics collider, so even small objects are easy to pinch"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Logging</span>"}'
    - '// @input bool enableLogging {"hint":"Enable general logging"}'
    - '// @input bool enableLoggingLifecycle {"hint":"Enable lifecycle logging (onAwake, onStart, onUpdate, onDestroy)"}'
