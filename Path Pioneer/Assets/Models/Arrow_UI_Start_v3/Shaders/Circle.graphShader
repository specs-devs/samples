    Node13:
      DependencyIndex: 23
      LevelID: 32
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float  StartValue;
            input_float  StartPower;
            input_float  EndValue;
            input_float  EndPower;
            input_float Progress; 
            
            output_float Result;
            
            float easePowerIn(float t, float power) {
                return pow(t, power);
            }
            float easePowerOut(float t, float power) {
                return 1.0 - pow(1.0 - t, power);
            }
            
            float nnormalize(float value, float minVal, float maxVal) {
                return (value - minVal) / (maxVal - minVal);
            }
            
            float denormalize(float value, float minVal, float maxVal) {
                return value * (maxVal - minVal) + minVal;
            }
            
            float interpolate(float a, float b, float t, float powerA, float powerB) {
                float normT = nnormalize(t, 0.0, 1.0);
                
            
                float easedTStart = easePowerIn(normT, powerA);
                float easedTEnd = easePowerOut(normT, powerB);
                float dif = abs(StartPower - EndPower);
            	float difPower = mix(0.2, 0.4, nnormalize(dif,0.0, 1.5));
            
                float blendFactor = smoothstep(0.5-difPower, 0.5+difPower, normT); 
                float normResult = mix(easedTStart, easedTEnd, blendFactor);
                return denormalize(normResult, a, b);
            }
            
            void main()
            {
            	float a = StartValue;
                float b = EndValue;
                float t = Progress;      
                float powerA = StartPower;
                float powerB = EndPower;    
                Result = interpolate(a, b, t, powerA, powerB);
            
            
            }
        Description:
          ClassType1: TEXT
          String: ""
        EndPower:
          Variable: 3.0
        EndValue:
          Variable: 1.0
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 32
        Locked:
          Variable: false
        Progress:
          Connection0:
            NodeLevelID: 26
            PortID: Output
          Variable: 0.0
        Result:
          IOType: 1
          Variable: 0.0
        Stage:
