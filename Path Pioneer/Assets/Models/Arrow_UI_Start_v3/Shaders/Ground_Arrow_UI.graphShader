    Node63:
      DependencyIndex: 87
      LevelID: 78
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float Progress; 
            input_float Feather; 
            input_float Gradient;
            input_checkbox Out; 
            input_checkbox Reevers;
            output_float wipe;
            
            
            void main() {
                float gradient = Gradient;
                float progress = mix(Progress - Feather, Progress + Feather, Progress);
                if(Reevers) {
                    gradient = 1.0 - Gradient;
                }
                wipe = smoothstep(progress - Feather, progress + Feather, gradient);
                if(!Out) {
                    wipe = 1.0 - wipe;
                }
            
            }
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
