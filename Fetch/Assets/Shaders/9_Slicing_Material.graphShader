        Node7:
          DependencyIndex: 14
          LevelID: 24
          NodeCount: 0
          NodeType: 1
          Ports:
            Code:
              ClassType1: TEXT
              String: |-
                input_vec2  UV;
                input_float MaxBorderSize;
                input_float SliceLeft;
                input_float SliceRight;
                input_float SliceTop;
                input_float SliceBottom;
                input_vec2  TextureSize;
                
                output_vec2 Result; 
                
                float clampBorderSize( float maxBorderSize, vec2 imageSize) {
                	return min( min( maxBorderSize, imageSize.x/2.0 ), imageSize.y/2.0 );
                }
                
                vec2 calculateBorders( vec2 texSize, float borderSize) {
                	return vec2( (texSize.x/texSize.y) * borderSize, borderSize);
                }
                
                bool epsilonEqual(float a, float b) {
                	return a + .0005 > b && a - .0005 < b;
                }
                
                void main()
                {
                    float scale_x         = length(system.getMatrixWorld()[0].xyz);
                    float scale_y         = length(system.getMatrixWorld()[1].xyz);
                    vec2 ImageSize        = vec2(scale_x, scale_y);
                	bool isOrtho = !epsilonEqual(system.getMatrixProjection()[3].w, 0.0);
                	if(isOrtho) {
                		vec2 orthoSize = abs(vec2(system.getMatrixProjection()[0].x, system.getMatrixProjection()[1].y));
                    		//We use 20.0 as the baseline because it is the default
                    		float orthoRatio = orthoSize.y / 0.1;
                    		ImageSize = ImageSize * orthoRatio;
                	}
                    float clampBorderSize = clampBorderSize(MaxBorderSize, ImageSize);
                    vec2  borderSize      = calculateBorders(TextureSize, clampBorderSize);
                	float borderLeft      = (SliceLeft * borderSize.x * 2.0) / ImageSize.x;
                	float borderRight     = 1.0-((SliceRight * borderSize.x * 2.0) / ImageSize.x);
                	float borderBottom    = (SliceBottom * borderSize.y * 2.0) / ImageSize.y;
                    float borderTop       = 1.0-((SliceTop * borderSize.y * 2.0) / ImageSize.y);
                
                	float remapU1 = system.remap( UV.x, 0.0, borderLeft, 0.0, SliceLeft );
                	float remapU2 = system.remap( UV.x, borderLeft, borderRight, SliceLeft, 1.0-SliceRight );
                    float remapU3 = system.remap( UV.x, borderRight, 1.0, 1.0-SliceRight, 1.0);
                
                    float remapV1 = system.remap( UV.y, 0.0, borderBottom, 0.0, SliceBottom );
                	float remapV2 = system.remap( UV.y, borderBottom, borderTop, SliceBottom, 1.0-SliceTop );
                    float remapV3 = system.remap( UV.y, borderTop, 1.0, 1.0-SliceTop, 1.0);
                
                    float slicedU = (UV.x < borderLeft) ? (remapU1) : ((UV.x < borderRight) ? (remapU2) : (remapU3));
                    float slicedV = (UV.y < borderBottom) ? (remapV1) : ((UV.y < borderTop) ? (remapV2) : (remapV3));
                	Result = vec2( slicedU, slicedV);
                }
            Description:
              ClassType1: TEXT
              String: |-
                9-slice scaling (also known as Scale 9 grid,  9-patch or 9-slicing ) is a 2D image resizing technique to proportionally scale an image by splitting it in a grid of nine parts.
                
                UV - coordinates of the surface;
                Border Scale - Size of the created border.
                Slice Left - 
                Slice Right - 
                Slice Top - 
                Slice Bottom - 
            Examples:
              ItemIndex: 0
              ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
