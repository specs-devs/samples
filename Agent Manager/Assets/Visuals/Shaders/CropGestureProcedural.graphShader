      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float planeAspect;
            input_float iconScale;
            output_vec2 Result; 
            
            void main()
            {
            	if (planeAspect > 1.0){
            		Result = vec2(iconScale, iconScale / planeAspect);
            	} else {
            		Result = vec2(iconScale * planeAspect,iconScale);
            	}
            }
