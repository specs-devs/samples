      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: RoundedRect
    Node8:
      DependencyIndex: 8
      LevelID: 11
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            // Inputs
            input_float planeAspect;
            input_float cornerSize;
            input_float currOutline;
            
            output_float Outline;
            
            void main()
            {
                vec2 uv = system.getSurfaceUVCoord0();
            
                // Corner thickness in UV space
                float cornerY = cornerSize;
                float cornerX = cornerSize;
            
            	if (planeAspect > 1.0){
            		cornerY *= planeAspect;
            	} else {
            		cornerX /= planeAspect;
            	}
            
                // Are we near the left/right edges?
                bool outsideX = (uv.x < cornerX) || (uv.x > 1.0 - cornerX);
                // Are we near the top/bottom edges?
                bool outsideY = (uv.y < cornerY) || (uv.y > 1.0 - cornerY);
            
                // Only draw corners, not edges
                if (outsideX && outsideY) {
                    Outline = currOutline;
                } else {
                    Outline = 0.0;
                }
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          BaseType: Asset.CustomCodeNodeAsset
          ScriptType: All
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 11
        Locked:
          Variable: false
        Outline:
          IOType: 1
          Variable: 0.0
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: RectCorners
        UseExternalFile:
          Variable: false
        cornerSize:
          Connection0:
            NodeLevelID: 12
            PortID: Output
          Variable: 0.0
        currOutline:
          Connection0:
            NodeLevelID: 0
            PortID: Outline
          Variable: 0.0
