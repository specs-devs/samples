    Node7:
      DependencyIndex: 7
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            // Appearance
            input_float cornerRadius;
            input_float planeAspect;
            input_float borderWidth;
            
            output_float Mask;
            output_float Outline;
            
            float roundedBoxSDF(vec2 p, vec2 b, float r)
            {
                // Signed distance to a rounded box centered at origin
                vec2 d = abs(p) - b + vec2(r);
                return length(max(d, 0.0)) - r;
            }
            
            void main()
            {
                vec2 uv = system.getSurfaceUVCoord0();
            
                // Centered UV
                vec2 p = uv - vec2(0.5, 0.5);
            
                float aspect = planeAspect;
                vec2 halfSize;
            
                // Put p into a space where units are "uniform" like you did before:
                if (aspect < 1.0) {
                    // Taller than wide: shrink X
                    p.x *= aspect;
                    halfSize = vec2(0.5 * aspect, 0.5);
                } else {
                    // Wider than tall: shrink Y
                    float invAspect = 1.0 / aspect;
                    p.y *= invAspect;
                    halfSize = vec2(0.5, 0.5 * invAspect);
                }
            
                // Signed distance to rounded rectangle in this uniform space
                float dist = roundedBoxSDF(p, halfSize, cornerRadius);
            
                // Filled mask
                Mask = 1.0 - smoothstep(0.0, 0.01, dist); 
            
                // Outline thickness in the SAME distance space
                float outlineThickness = borderWidth;
            
                float innerEdge  = smoothstep(0.0,              0.01,              dist);
                float innerLimit = smoothstep(-outlineThickness,
                                              -outlineThickness + 0.01,            dist);
            
                Outline = innerLimit - innerEdge;
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          BaseType: Asset.CustomCodeNodeAsset
          ScriptType: All
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Mask:
          IOType: 1
          Variable: 0.0
        Outline:
          IOType: 1
          Variable: 0.0
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: RoundedRect
        UseExternalFile:
          Variable: false
        borderWidth:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: 0.0
        cornerRadius:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        planeAspect:
          Connection0:
            NodeLevelID: 14
            PortID: Output
          Variable: 0.0
      PositionX: 3100
