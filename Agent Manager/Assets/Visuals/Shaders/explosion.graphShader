    Node4:
      DependencyIndex: 4
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec2 uv;
            input_float u_time;
            input_float u_expl_start;
            input_float u_aspect_ratio;
            output_vec4 Result;
            
            float hash(vec2 p) {
                p = fract(p * vec2(123.34, 456.21));
                p += dot(p, p + 45.32);
                return fract(p.x * p.y);
            }
            
            float noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                f = f * f * (3.0 - 2.0 * f);
                float a = hash(i);
                float b = hash(i + vec2(1.0, 0.0));
                float c = hash(i + vec2(0.0, 1.0));
                float d = hash(i + vec2(1.0, 1.0));
                return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
            }
            
            float fbm(vec2 p) {
                float f = 0.0;
                float amp = 0.5;
                mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
                for(int i = 0; i < 5; i++) {
                    f += amp * noise(p);
                    p = rot * p * 2.0 + vec2(100.0, 100.0);
                    amp *= 0.5;
                }
                return f;
            }
            
            void main() {
                float pixelSize = 120.0;
                vec2 centeredUV = uv - 0.5;
                centeredUV.x *= u_aspect_ratio;
                centeredUV *= 2.0;
                
                vec2 pUV = floor(centeredUV * pixelSize) / pixelSize;
                vec2 vPixel = floor(centeredUV * pixelSize);
            
                float t = u_expl_start >= 0.0 ? max(0.0, u_time - u_expl_start) : 0.0;
                float duration = 4.2;
                float fps = 15.0;
                float sTime = floor(t * fps) / fps;
            
                vec2 center = vec2(0.0, sTime * 0.15);
                vec2 pUV_drift = pUV - center;
            
                float d = length(pUV_drift);
                vec2 dir = d > 0.0 ? pUV_drift / d : vec2(0.0, 0.0);
            
                vec3 finalColor = vec3(0.0, 0.0, 0.0);
                float alpha = 0.0;
            
                if (sTime > 0.0 && sTime < duration) {
                    float nTime = sTime / duration;
            
                    vec2 warpCoord = pUV_drift * 2.5 - dir * sTime * 2.0;
                    vec2 q = vec2(fbm(warpCoord), fbm(warpCoord + vec2(1.2, 3.4)));
                    float warpNoise = fbm(warpCoord + 3.0 * q + sTime * 1.2);
            
                    float n = fbm(pUV_drift * 3.5 + warpNoise * 2.5);
            
                    float angle = atan(pUV_drift.y, pUV_drift.x);
                    float qAngleForLobe = floor(angle * 8.0) / 8.0;
                    float asymmetry = fbm(vec2(qAngleForLobe * 3.0, sTime * 0.8)) * 0.6 + 0.4;
            
                    float maxRadius = 1.0 + sTime * 0.5;
                    float baseRadius = maxRadius * (1.0 - exp(-sTime * (6.0 + asymmetry)));
                    float fireRadius = baseRadius * 0.85 * exp(-sTime * 1.0);
            
                    float boundaryDist = baseRadius - d + (n - 0.5) * 1.2;
                    float flatShape = clamp(boundaryDist * 2.0, 0.0, 1.0);
            
                    float erosion = nTime * (1.2 + n * 2.0);
                    float smokeDensity = clamp(flatShape - erosion, 0.0, 1.0);
            
                    float fireBoundary = fireRadius - d + (n - 0.5) * 0.8;
                    float fireDensity = clamp(fireBoundary * 2.0, 0.0, 1.0);
            
                    float temp = fireDensity * exp(-sTime * 1.2) * (n * 2.0 + 0.2);
            
                    float totalIntensity = smokeDensity * 0.24 + temp * 1.5;
            
                    if (totalIntensity > 0.01) {
                        float bands = 7.0;
                        float qIntensity = floor(totalIntensity * bands) / bands;
            
                        vec3 col;
                        if (qIntensity >= 0.8) col = vec3(1.0, 1.0, 1.0);
                        else if (qIntensity >= 0.6) col = vec3(1.0, 1.0, 0.0);
                        else if (qIntensity >= 0.4) col = vec3(1.0, 0.5, 0.0);
                        else if (qIntensity >= 0.25) col = vec3(0.8, 0.1, 0.0);
                        else if (qIntensity >= 0.12) col = vec3(0.4, 0.4, 0.4);
                        else col = vec3(0.15, 0.15, 0.15);
            
                        float dither = mod(vPixel.x + vPixel.y, 2.0);
            
                        if (totalIntensity < 0.1 && dither > 0.5) {
                            alpha = 0.0;
                        } else {
                            finalColor = col;
                            alpha = 1.0;
                        }
                    }
            
                    if (sTime < 0.1 && length(pUV) < 1.0) {
                        if (mod(vPixel.x, 2.0) == mod(vPixel.y, 2.0)) {
                            finalColor = vec3(1.0, 0.9, 0.8);
                            alpha = 1.0;
                        }
                    }
                }
            
                Result = vec4(finalColor, alpha);
            }
