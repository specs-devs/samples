    Node7:
      DependencyIndex: 7
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        ArcCenter:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: [0.0, 0.0]
        ArcSpread:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
        Code:
          ClassType1: TEXT
          String: |-
            input_vec2 RingRadius;
            input_vec2 RingStroke;
            input_vec2 ArcCenter;
            input_float ArcSpread;
            output_vec3 WorldPos;
            
            void main()
            {
            	vec3 pos = system.getSurfacePositionObjectSpace(); // [-0.5, 0.5]
            	vec2 uv0 = system.getSurfaceUVCoord0(); // (1, 0) or (0, 1)
            	vec2 uv1 = system.getSurfaceUVCoord1(); // [-0.5, 0.5]
            	pos.xy *= dot(uv0, RingStroke);
            	pos.x += dot(uv0, RingRadius);
            	float theta = dot(uv0, ArcCenter);
            	theta += ArcSpread * uv1.x;
            	float ct = cos(theta);
            	float st = sin(theta);
            	float x = dot(pos.xy, vec2(ct, -st));
            	float y = dot(pos.xy, vec2(st, ct));
            	pos.x = x;
            	pos.y = y;
            	vec4 wpos = system.getMatrixWorld() * vec4(pos, 1.0);
            	WorldPos = wpos.xyz / wpos.w;
            }
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        RingRadius:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0]
        RingStroke:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [0.0, 0.0]
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
