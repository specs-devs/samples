      Title1: Add
    Node3:
      DependencyIndex: 3
      LevelID: 43
      NodeCount: 0
      NodeType: 1
      Ports:
        AtlasTexture:
          ClassType2: TEXTURE_OBJECT_2D
          Connection0:
            NodeLevelID: 42
            PortID: Texture
        Code:
          ClassType1: TEXT
          String: |-
            input_int TrackID;
            input_float SamplePoint;
            input_vec4 MetaData;
            input_texture_2d AtlasTexture;
            output_float Result; 
            
            void main()
            {
            	vec2 pixelSize = AtlasTexture.pixelSize();
            	float highIndex = pixelSize.y * float(TrackID);
            
            	vec2 minmaxTime;
            	minmaxTime.x = system.unpack16Bit(AtlasTexture.sample(vec2(0.0, highIndex)).rg, MetaData.x, MetaData.y);
            	minmaxTime.y = system.unpack16Bit(AtlasTexture.sample(vec2(0.0, highIndex)).ba, MetaData.x, MetaData.y);
            	
            	float Point = SamplePoint;
            
            	Point = system.remap(SamplePoint, minmaxTime.x, minmaxTime.y, pixelSize.x, 1.0);
            
            	vec2 uv = vec2(Point, highIndex);
            
            	vec2 atlas = AtlasTexture.sample(uv).rg;
            
            	Result = system.unpack16Bit(atlas, MetaData.x, MetaData.y);
            
            
            }
        Description:
          ClassType1: TEXT
          String: |-
            -Track ID - The row id of the atals texture, it deteriamns which Animation Curve used, the first track ID starts at 0.
            
            -Sample Point - Time, the colume id of the atals texture, when the texture wrap mode is set to Clamp To Edges from the script, the animation will not loop.
            
            -Meta Data - [ Do Not Edit ] - It recieves the width and height of the atlas texture from script.
            
            -Atlas Texture - [ Do Not Edit ] - It recieves the encoded atlas from script..
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 43
        Locked:
          Variable: false
        MetaData:
          Connection0:
            NodeLevelID: 41
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        Result:
          IOType: 1
          Variable: 0.0
