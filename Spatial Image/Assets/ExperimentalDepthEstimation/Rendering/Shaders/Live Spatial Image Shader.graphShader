    Node12:
      DependencyIndex: 12
      LevelID: 2
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float u_radius;
            input_float u_softness;	
            
            output_float Result;
            
            float roundedBox(vec2 p, vec2 b, float r) {
                vec2 q = abs(p) - b + r;
                return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
            }
            
            void main() {
            
                vec2 uv = system.getSurfaceUVCoord0();
            	//fade alpha along the edges
                vec2 center_uv = uv * 2.0 - 1.0; // Move to -1.0 to 1.0 range
                
                // Calculate the box shape
                float dist = roundedBox(center_uv, vec2(1.0, 1.0), u_radius);
                Result = smoothstep(0.0, -u_softness, dist);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          BaseType: Asset.CustomCodeNodeAsset
          ScriptType: All
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 2
        Locked:
          Variable: false
        Result:
          IOType: 1
          Variable: 0.0
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Fade
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        u_radius:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        u_softness:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
      PositionX: 402
      PositionY: 404
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Fade
